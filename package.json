{
  "name": "pet-companion",
  "version": "0.1.4",
  "description": "Кот или собака рядом со страницей: спокойный спутник, который радуется подтверждённым занятиям сайта. ES-модули и CSS без зависимостей и сборки.",
  "keywords": [
    "pet",
    "companion",
    "cat",
    "dog",
    "svg",
    "esm",
    "browser",
    "gamification"
  ],
  "license": "MIT",
  "author": "jivchic88",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jivchic88/pet-companion.git"
  },
  "homepage": "https://github.com/jivchic88/pet-companion#readme",
  "bugs": {
    "url": "https://github.com/jivchic88/pet-companion/issues"
  },
  "type": "module",
  "main": "./pet/pet.mjs",
  "types": "./pet/pet.d.mts",
  "exports": {
    ".": {
      "types": "./pet/pet.d.mts",
      "default": "./pet/pet.mjs"
    },
    "./core": {
      "types": "./pet/core.d.mts",
      "default": "./pet/core.mjs"
    },
    "./pets": {
      "types": "./pet/pets.d.mts",
      "default": "./pet/pets.mjs"
    },
    "./behaviors": {
      "types": "./pet/behaviors.d.mts",
      "default": "./pet/behaviors.mjs"
    },
    "./web": {
      "types": "./pet/web.d.mts",
      "default": "./pet/web.mjs"
    },
    "./react": {
      "types": "./pet/react.d.mts",
      "default": "./pet/react.mjs"
    },
    "./pet.css": {
      "types": "./pet/css.d.mts",
      "default": "./pet/pet.css"
    },
    "./dog.css": {
      "types": "./pet/css.d.mts",
      "default": "./pet/dog.css"
    },
    "./pet-base.css": {
      "types": "./pet/css.d.mts",
      "default": "./pet/pet-base.css"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "pet/",
    "manifest.json",
    "example.html",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "test:package": "node test/package.mjs",
    "test:consumers": "node test/consumers.mjs",
    "manifest": "node scripts/manifest.mjs",
    "version": "node scripts/sync-version.mjs && node scripts/manifest.mjs && git add pet/core/version.mjs README.md CHANGELOG.md manifest.json",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "playwright-core": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
